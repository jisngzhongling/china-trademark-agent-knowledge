.DS_Store
__pycache__/
*.py[cod]

# Codex local state and environment secrets
.codex/
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Client matters, evidence, work products, and temporary outputs
matters/
source/
evidence/
deliverables/
outputs/
audit/
work/
qa/
tmp/

# Binary working files are excluded by default. Only reviewed public
# references and reusable templates are admitted below.
*.pdf
*.xlsx
*.xls
*.zip
*.7z
*.rar
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.heic
*.docx
!knowledge/reference/*.xlsx
!knowledge/reference/*.docx
!templates/*.docx

# Editor and temporary files
*.tmp
*.bak
*.swp
~$*
